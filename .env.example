# VerseBuilder Environment Configuration

# 1. Supabase (Authentication & PostgreSQL Database)
# Get from: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Cloudinary (Photos & Video Cloud Storage)
# Get from: https://cloudinary.com -> Dashboard & Settings -> Upload -> Upload presets
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=versebuilder_uploads

# 3. Optional: Public site URL for production OpenGraph & canonical URLs
VITE_SITE_URL=https://your-domain.com
